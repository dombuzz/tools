<html lang="de"><head><meta http-equiv="Content-Type" content="text/html; charset=UTF-8">
  
  <meta name="viewport" content="width=device-width,initial-scale=1">

  <link rel="preconnect" href="https://fonts.googleapis.com/">
  <link rel="preconnect" href="https://fonts.gstatic.com/" crossorigin="">
  <link href="./eli_files/css2" rel="stylesheet">

  <style>
    :root{
      --bg: #060C22;
      --text: #ffffff;
      --accent:  #f59e0b;
      --accent2: #f97316;
    }

    *{ box-sizing:border-box; }
    html,body{ height:100%; }

    body{
      margin:0;
      font-family: Inter, ui-sans-serif, system-ui, -apple-system, Segoe UI, Roboto, Helvetica, Arial;
      color:var(--text);
      background:
        radial-gradient(900px 600px at 20% 10%, rgba(245,158,11,.18), transparent 55%),
        radial-gradient(900px 600px at 80% 20%, rgba(249,115,22,.14), transparent 55%),
        linear-gradient(180deg, var(--bg), var(--bg));
      display:grid;
      place-items:center;
      padding:32px 16px;
    }

    .wrap{ text-align:center; }

    .sun{
      font-size:48px;
      margin-bottom:24px;
    }

    .entry{
      font-size:32px;
      font-weight:800;
      letter-spacing:-0.02em;
      font-variant-numeric: tabular-nums;
      margin:10px 0;
      white-space:nowrap;
    }

    /* Zahlen */
    .value{
      opacity:1;
    }

    /* Einheiten */
    .unit{
      font-weight:600;
      margin-left:8px;
      opacity:.75;
    }

    .hidden{ display:none; }

    @media (max-width: 480px){
      .entry{ font-size:24px; }
    }
  </style>
</head>

<body>
  <main class="wrap" aria-label="Countdown-Differenz (konsistente Restwerte) zum 7. November 2025">
    <div class="sun">☀️</div>

    <div class="entry hidden" id="row-years"><span class="value" id="years">0</span><span class="unit" id="unit-years">Jahre</span></div>
    <div class="entry" id="row-months"><span class="value" id="months">10</span><span class="unit" id="unit-months">Monate</span></div>
    <div class="entry" id="row-weeks"><span class="value" id="weeks">3</span><span class="unit" id="unit-weeks">Wochen</span></div>
    <div class="entry hidden" id="row-days"><span class="value" id="days">0</span><span class="unit" id="unit-days">Tage</span></div>
  </main>

  <script>
    const target = new Date(2025, 10, 7);
    const MS_PER_DAY = 24 * 60 * 60 * 1000;

    const elYears  = document.getElementById("years");
    const elMonths = document.getElementById("months");
    const elWeeks  = document.getElementById("weeks");
    const elDays   = document.getElementById("days");

    const rowYears  = document.getElementById("row-years");
    const rowMonths = document.getElementById("row-months");
    const rowWeeks  = document.getElementById("row-weeks");
    const rowDays   = document.getElementById("row-days");

    const unitYears  = document.getElementById("unit-years");
    const unitMonths = document.getElementById("unit-months");
    const unitWeeks  = document.getElementById("unit-weeks");
    const unitDays   = document.getElementById("unit-days");

    function startOfTodayLocal(){
      const now = new Date();
      return new Date(now.getFullYear(), now.getMonth(), now.getDate());
    }

    function addMonthsSafe(date, months){
      const d = new Date(date);
      const day = d.getDate();
      d.setDate(1);
      d.setMonth(d.getMonth() + months);
      const lastDay = new Date(d.getFullYear(), d.getMonth() + 1, 0).getDate();
      d.setDate(Math.min(day, lastDay));
      return d;
    }

    function fullYearsBetween(start, end){
      let years = end.getFullYear() - start.getFullYear();
      const candidate = new Date(start);
      candidate.setFullYear(start.getFullYear() + years);
      if (candidate > end) years -= 1;
      return Math.max(0, years);
    }

    function fullMonthsBetween(start, end){
      let months = (end.getFullYear() - start.getFullYear()) * 12 + (end.getMonth() - start.getMonth());
      const candidate = addMonthsSafe(start, months);
      if (candidate > end) months -= 1;
      return Math.max(0, months);
    }

    function setUnit(unitEl, n, singular, plural){
      unitEl.textContent = (n === 1) ? singular : plural;
    }

    function setRow(rowEl, valueEl, unitEl, n, singular, plural){
      if (n === 0){
        rowEl.classList.add("hidden");
        return false;
      }
      rowEl.classList.remove("hidden");
      valueEl.textContent = n;
      setUnit(unitEl, n, singular, plural);
      return true;
    }

    function update(){
      const today = startOfTodayLocal();
      const start = (today >= target) ? target : today;
      const end   = (today >= target) ? today : target;

      const years = fullYearsBetween(start, end);
      const afterYears = new Date(start);
      afterYears.setFullYear(start.getFullYear() + years);

      const monthsTotalAfterYears = fullMonthsBetween(afterYears, end);
      const months = monthsTotalAfterYears % 12;
      const afterMonths = addMonthsSafe(afterYears, monthsTotalAfterYears);

      const remainingDays = Math.trunc((end - afterMonths) / MS_PER_DAY);
      const weeks = Math.floor(remainingDays / 7);
      const days  = remainingDays % 7;

      const showYears  = setRow(rowYears,  elYears,  unitYears,  years, "Jahr",  "Jahre");
      const showMonths = setRow(rowMonths, elMonths, unitMonths, months, "Monat", "Monate");
      const showWeeks  = setRow(rowWeeks,  elWeeks,  unitWeeks,  weeks, "Woche", "Wochen");
      const showDays   = setRow(rowDays,   elDays,   unitDays,   days,  "Tag",   "Tage");

      if (!showYears && !showMonths && !showWeeks && !showDays){
        rowDays.classList.remove("hidden");
        elDays.textContent = "0";
        unitDays.textContent = "Tage";
      }
    }

    update();
    setInterval(update, 60 * 1000);
  </script>


</body></html>
