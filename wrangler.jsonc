{
  // Cloudflare Worker für Likes und Nutzungen (Code: worker/index.js)
  // Wird von Cloudflare bei jedem Push auf main automatisch veröffentlicht.
  "name": "fragrant-grass-c193",
  "main": "worker/index.js",
  "compatibility_date": "2025-09-01",
  // Version und Zeitpunkt des Deploys (für die Dashboard-Box «Detagls»)
  "version_metadata": { "binding": "CF_VERSION_METADATA" },
  // Geplante Aufgaben (worker/index.js → scheduled): stündliche Kontrolle (Kontingent, Deploy, Backup → Teams) und Monatsbericht am 1. um 06:03 UTC
  "triggers": { "crons": ["17 * * * *", "3 6 1 * *"] },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "dombuzz-likes",
      "database_id": "be639ac8-3c52-4c14-8a2c-4d3b1b84c320"
    }
  ],
  // Mail bei neuem Feedback (worker/index.js → fbMail) über Resend; aktiv, sobald das Secret RESEND_API_KEY gesetzt ist.
  "vars": {
    "FEEDBACK_TO": "hei@dombuzz.ch, dominik.hardegger@rtr.ch",
    "FEEDBACK_FROM": "dombuzz Tools <tools@dombuzz.ch>",
    // Für das Log-Kontingent auf /stats (Token kommt als Secret CF_API_TOKEN dazu, nicht hier eintragen)
    "CF_ACCOUNT_ID": "39da93a659736066e9818f5eba757d5e",
    // Wöchentliches Backup in kDrive (Ordner dombuzz-backups); Token als Secret KDRIVE_TOKEN (Scope «drive»)
    "KDRIVE_DRIVE_ID": "1649072",
    "KDRIVE_DIR_ID": "12713"
  }
}
