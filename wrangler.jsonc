{
  // Cloudflare Worker für Likes und Nutzungen (Code: worker/index.js)
  // Wird von Cloudflare bei jedem Push auf main automatisch veröffentlicht.
  "name": "fragrant-grass-c193",
  "main": "worker/index.js",
  "compatibility_date": "2025-09-01",
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "dombuzz-likes",
      "database_id": "be639ac8-3c52-4c14-8a2c-4d3b1b84c320"
    }
  ],
  // Mail bei neuem Feedback (worker/index.js → fbMail). Versand erst aktiv, wenn das Binding «send_email» ergänzt ist
  // (setzt Email Routing auf dombuzz.ch mit bestätigter Zieladresse voraus).
  "vars": {
    "FEEDBACK_TO": "dominik.hardegger@rtr.ch",
    "FEEDBACK_FROM": "feedback@dombuzz.ch",
    // Für das Log-Kontingent auf /stats (Token kommt als Secret CF_API_TOKEN dazu, nicht hier eintragen)
    "CF_ACCOUNT_ID": "39da93a659736066e9818f5eba757d5e"
  }
}
